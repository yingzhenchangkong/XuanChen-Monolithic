<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xuanchen.masterdata.mdpost.mapper.MdPostMapper">
    <!-- 回收站 列表 -->
    <select id="listRecycleBin" resultType="com.xuanchen.masterdata.mdpost.entity.MdPost">
        SELECT
        id,
        post_code,
        post_name,
        post_description
        FROM
        md_post
        WHERE
        del_flag = 1
        <if test="mdPost.postName != '' and mdPost.postName != null">
            <bind name="postName" value="'%' + mdPost.postName + '%'"/>
            AND post_name like #{postName}
        </if>
        <if test="mdPost.postDescription != '' and mdPost.postDescription != null">
            <bind name="postDescription" value="'%' + mdPost.postDescription + '%'"/>
            AND post_description like #{postDescription}
        </if>
    </select>
    <!-- 回收站 彻底删除 -->
    <delete id="deleteRecycleBin">
        DELETE FROM md_post
        WHERE
        del_flag = 1
        AND id in
        <foreach collection="mdPostIds" index="index" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <!-- 回收站 还原 -->
    <update id="revertRecycleBin">
        UPDATE md_post set del_flag = 0
        WHERE
        del_flag = 1
        AND id in
        <foreach collection="mdPostIds" index="index" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <select id="ifExistsId" parameterType="com.xuanchen.masterdata.mdpost.entity.MdPost" resultType="com.xuanchen.masterdata.mdpost.entity.MdPost">
        SELECT
        *
        FROM
        (SELECT * FROM md_post WHERE id NOT IN (#{mdPost.id})) md_post
        <where>
            <if test="mdPost.postCode != '' and mdPost.postCode != null">
                AND post_code = #{mdPost.postCode}
            </if>
            <if test="mdPost.postName != '' and mdPost.postName != null">
                AND post_name = #{mdPost.postName}
            </if>
        </where>
    </select>

    <select id="ifExistsNoId" parameterType="com.xuanchen.masterdata.mdpost.entity.MdPost" resultType="com.xuanchen.masterdata.mdpost.entity.MdPost">
        SELECT
            *
        FROM
            md_post
        <where>
            <if test="mdPost.postCode != '' and mdPost.postCode != null">
                AND post_code = #{mdPost.postCode}
            </if>
            <if test="mdPost.postName != '' and mdPost.postName != null">
                AND post_name = #{mdPost.postName}
            </if>
        </where>
    </select>
</mapper>