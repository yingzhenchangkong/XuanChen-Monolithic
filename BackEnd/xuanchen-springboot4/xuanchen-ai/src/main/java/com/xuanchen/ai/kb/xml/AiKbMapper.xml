<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xuanchen.ai.kb.mapper.AiKbMapper">

    <!-- 回收站分页（del_flag=1；条件与列表页一致：名称模糊、状态） -->
    <select id="listRecycleBin" resultType="com.xuanchen.ai.kb.entity.AiKb">
        SELECT *
        FROM ai_kb
        WHERE del_flag = 1
        <if test="kb.kbName != null and kb.kbName != ''">
            AND kb_name LIKE CONCAT('%', #{kb.kbName}, '%')
        </if>
        <if test="kb.status != null">
            AND status = #{kb.status}
        </if>
        ORDER BY create_time DESC
    </select>

    <!-- 彻底删除（物理 DELETE） -->
    <delete id="deleteRecycleBin">
        DELETE FROM ai_kb
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 恢复（del_flag 置回 0） -->
    <update id="revertRecycleBin">
        UPDATE ai_kb
        SET del_flag = 0
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>
