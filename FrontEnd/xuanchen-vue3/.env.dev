NODE_ENV = "development"
# 浏览器侧统一使用同源相对地址：请求打到 Vite dev server，由 vite.config.ts 的
# /api 代理转发到后端（去前缀），开发期不直连后端、不触发 CORS。
# axios baseURL（接口统一前缀）
APP_BASE_URL = "/api"
# 以下两个是“后端相对路径”：走 axios 时自动拼 /api；a-upload action、<img src>
# 等浏览器直发场景需在使用处自行补 APP_BASE_URL 前缀
APP_FILE_UPLOAD_PATH = "/filemanage/upload"
APP_FILE_VIEW_PATH = "/filemanage/static/"
# dev server 代理目标（仅 Node 侧读取，不会进入浏览器包），指向本地后端
APP_PROXY_TARGET = "http://localhost:8080"
# WS 握手时代理改写的 Origin（需在后端 xuanchen.cors.allowed-origins 白名单内，
# 默认即 http://localhost:8060），dev server 端口漂移时也无需改后端配置
APP_PROXY_WS_ORIGIN = "http://localhost:8060"
